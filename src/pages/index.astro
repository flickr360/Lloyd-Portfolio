<style>
  /* Entrance animation hooked to the preloader completion */
  .hero-fade {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.85s cubic-bezier(0.16, 1, 0.3, 1), transform 0.85s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: opacity, transform;
  }

  /* Staggered entrance timing */
  :global(.loader-complete) .hero-fade-1 {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.05s;
  }

  :global(.loader-complete) .hero-fade-2 {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.18s;
  }

  :global(.loader-complete) .hero-fade-3 {
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.32s;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fade {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
  }
</style>

<script is:inline>
  // Specular flashlight sweep on mousemove for glass cards
  document.querySelectorAll('[data-glass-card]').forEach((card) => {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty('--glass-card-mouse-x', `${e.clientX - rect.left}px`);
      card.style.setProperty('--glass-card-mouse-y', `${e.clientY - rect.top}px`);
    });
  });

  // Unified Stat Counter Animation (Coffee + Active Repos)
  function triggerStatCounters() {
    var counters = document.querySelectorAll('.stat-counter');
    counters.forEach(function (counter) {
      if (counter.getAttribute('data-started') === 'true') return;
      counter.setAttribute('data-started', 'true');

      var target = parseInt(counter.getAttribute('data-target'), 10) || 0;
      var duration = 2000;
      var startTime = performance.now();

      function update(now) {
        var elapsed = now - startTime;
        var progress = Math.min(elapsed / duration, 1);
        var easeOut = 1 - Math.pow(1 - progress, 3);
        var currentVal = Math.floor(easeOut * target);

        counter.textContent = currentVal.toLocaleString();

        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          counter.textContent = target.toLocaleString();
        }
      }

      requestAnimationFrame(update);
    });
  }

  // 1. Listen for preloader finish event
  window.addEventListener('loader:finished', function () {
    setTimeout(triggerStatCounters, 320);
  });

  // 2. MutationObserver fallback
  var observer = new MutationObserver(function () {
    if (document.documentElement.classList.contains('loader-complete')) {
      setTimeout(triggerStatCounters, 320);
      observer.disconnect();
    }
  });
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

  // 3. Immediate execution if page is already loaded
  if (document.documentElement.classList.contains('loader-complete') || document.readyState === 'complete') {
    setTimeout(triggerStatCounters, 320);
  }

  // Video fallback for reduced motion
  (function () {
    var video = document.getElementById('bg-video');
    if (!video) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.pause();
      video.removeAttribute('autoplay');
    }
  })();
</script>