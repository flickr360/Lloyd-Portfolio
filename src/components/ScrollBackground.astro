---
// Clean Deep Space Background: High-Performance Curved Star Trails + Twinkles
---

<div class="fixed inset-0 z-0 pointer-events-none overflow-hidden bg-[#030305]" aria-hidden="true">
  <!-- Accelerated Canvas -->
  <canvas id="space-star-canvas" class="w-full h-full object-cover pointer-events-none"></canvas>

  <!-- High-efficiency static vignette (removed CSS backdrop-filter) -->
  <div 
    class="absolute inset-0 pointer-events-none"
    style="background: radial-gradient(circle at 80% 20%, rgba(3,3,5,0.15) 0%, rgba(0,0,0,0.85) 85%);"
  ></div>
</div>

<script is:inline>
  (function () {
    var canvas = document.getElementById('space-star-canvas');
    if (!canvas) return;
    var ctx = canvas.getContext('2d', { alpha: false, desynchronized: true });

    var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var width = 0;
    var height = 0;
    var originX = 0;
    var originY = 0;

    function resize() {
      width = canvas.width = window.innerWidth;
      height = canvas.height = window.innerHeight;
      originX = width * 0.82;
      originY = -height * 0.15;
      initStars();
    }

    // Capped at 400 for optimal fill-rate efficiency without visual sparse spots
    var STAR_COUNT = Math.min(Math.floor((window.innerWidth * window.innerHeight) / 2500), 750);
    var stars = [];
    var starColors = ['#ffffff', '#f2f0ea', '#dbeafe', '#fef08a', '#ff3d00'];

    function initStars() {
      stars = [];
      var maxRadius = Math.hypot(Math.max(originX, width - originX), Math.max(originY, height - originY));

      for (var i = 0; i < STAR_COUNT; i++) {
        var isAccent = Math.random() > 0.92;
        var tier = Math.random();
        var baseSize = tier > 0.96 ? 2.4 : tier > 0.75 ? 1.5 : 0.8;

        stars.push({
          radius: Math.pow(Math.random(), 0.85) * maxRadius + 20,
          angle: Math.random() * Math.PI * 2,
          baseSize: baseSize,
          color: isAccent ? '#ff3d00' : starColors[Math.floor(Math.random() * (starColors.length - 1))],
          baseAlpha: Math.random() * 0.45 + 0.3,
          speedMult: Math.random() * 0.5 + 0.75,
          isTwinkling: false,
          twinkleProgress: 0,
          twinkleDuration: 1000,
        });
      }
    }

    resize();
    window.addEventListener('resize', resize, { passive: true });

    // Angular momentum & scroll tracking
    var root = document.documentElement;
    var lastScrollY = window.scrollY || root.scrollTop;
    var angularVelocity = 0;
    var targetAngularVelocity = 0;
    var isMoving = false;
    var hasActiveTwinkles = false;

    // Twinkle Controller
    var TARGET_ACTIVE_TWINKLES = 4;
    var nextCountCheck = 0;

    function updateTwinkleQueue(timestamp) {
      if (timestamp > nextCountCheck) {
        TARGET_ACTIVE_TWINKLES = Math.floor(Math.random() * 6) + 3; // 3 to 8 active twinkles
        nextCountCheck = timestamp + Math.random() * 2500 + 1500;
      }

      var currentActive = 0;
      for (var i = 0; i < stars.length; i++) {
        if (stars[i].isTwinkling) currentActive++;
      }

      if (currentActive < TARGET_ACTIVE_TWINKLES && stars.length > 0) {
        var idx = Math.floor(Math.random() * stars.length);
        var s = stars[idx];
        if (!s.isTwinkling) {
          s.isTwinkling = true;
          s.twinkleProgress = 0;
          s.twinkleDuration = Math.random() * 1000 + 900;
        }
      }
    }

    var scrollTicking = false;
    window.addEventListener(
      'scroll',
      function () {
        var currentY = window.scrollY || root.scrollTop;
        var delta = currentY - lastScrollY;
        lastScrollY = currentY;

        targetAngularVelocity = delta * 0.003;

        if (!scrollTicking) {
          requestAnimationFrame(function () {
            var docHeight = root.scrollHeight - window.innerHeight;
            var progress = docHeight > 0 ? currentY / docHeight : 0;
            root.style.setProperty('--scroll-y', currentY.toFixed(1));
            root.style.setProperty('--scroll-progress', progress.toFixed(4));
            scrollTicking = false;
          });
          scrollTicking = true;
        }
      },
      { passive: true }
    );

    var lastTimestamp = 0;
    ctx.lineCap = 'round';

    function render(timestamp) {
      if (!lastTimestamp) lastTimestamp = timestamp;
      var dt = timestamp - lastTimestamp;
      lastTimestamp = timestamp;

      // Friction dampening
      angularVelocity += (targetAngularVelocity - angularVelocity) * 0.1;
      targetAngularVelocity *= 0.85;

      var sweepAngle = Math.max(-0.55, Math.min(0.55, angularVelocity * 4.5));
      isMoving = Math.abs(sweepAngle) > 0.001 && !reduceMotion;

      // Fast clear
      ctx.fillStyle = '#030305';
      ctx.fillRect(0, 0, width, height);

      if (!isMoving) {
        updateTwinkleQueue(timestamp);
      }

      hasActiveTwinkles = false;

      // Render all stars in a flat loop (no save/restore or shadowBlur overhead)
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        var currentAlpha = s.baseAlpha;
        var currentSize = s.baseSize;

        if (s.isTwinkling && !isMoving) {
          s.twinkleProgress += dt / s.twinkleDuration;
          if (s.twinkleProgress >= 1) {
            s.isTwinkling = false;
          } else {
            hasActiveTwinkles = true;
            var flare = Math.sin(s.twinkleProgress * Math.PI);
            currentAlpha = Math.min(1.0, s.baseAlpha + flare * 0.7);
            currentSize = s.baseSize * (1 + flare * 1.6);
          }
        }

        ctx.globalAlpha = isMoving ? s.baseAlpha : currentAlpha;
        ctx.strokeStyle = s.color;
        ctx.fillStyle = s.color;

        if (isMoving) {
          var arcLength = sweepAngle * s.speedMult;
          ctx.lineWidth = currentSize;
          ctx.beginPath();
          ctx.arc(originX, originY, s.radius, s.angle, s.angle + arcLength, arcLength < 0);
          ctx.stroke();
          s.angle += arcLength * 0.035;
        } else {
          var x = originX + Math.cos(s.angle) * s.radius;
          var y = originY + Math.sin(s.angle) * s.radius;

          // Viewport culling: only draw stars visible within the screen
          if (x >= -10 && x <= width + 10 && y >= -10 && y <= height + 10) {
            ctx.beginPath();
            ctx.arc(x, y, currentSize, 0, 6.2831853);
            ctx.fill();
          }
        }
      }

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  })();
</script>